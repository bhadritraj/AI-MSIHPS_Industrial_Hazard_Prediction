# AI-MSIHPS Environment Configuration
# Copy this to .env and fill in your values

SECRET_KEY=msihps-secret-key-2026-vit-chennai

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/msihps

# MQTT Broker
MQTT_BROKER=localhost
MQTT_PORT=1883

# Flask
FLASK_ENV=development
FLASK_DEBUG=1

# Optional: SMS alerts via Twilio
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_FROM_NUMBER=+1234567890
SUPERVISOR_PHONE=+919876543210
